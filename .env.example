# Puerto y Host de Node.js (backend-core)
PORT=3000

# Puerto y Host de Python FastAPI (agent-brain)
AGENT_PORT=8000
AGENT_HOST=127.0.0.1

# Token de verificación de Meta Webhook (puedes cambiarlo a tu preferencia)
WHATSAPP_VERIFY_TOKEN=mark_secret_token

# API Keys para la Inteligencia Artificial (Completa la que vayas a usar)
OPENAI_API_KEY=tu_openai_api_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Proveedor por defecto de IA: gemini o openai
DEFAULT_AI_PROVIDER=gemini

# Token de Resend API (para envío de correos de ventas y reportes mensuales)
RESEND_API_KEY=re_tu_resend_api_key_aqui

# Credenciales para el bot de Telegram (para aprobaciones manuales internas de la agencia)
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui
